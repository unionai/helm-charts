{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "config": {
      "properties": {
        "core": {
          "properties": {
            "webhook": {
              "properties": {
                "embeddedSecretManagerConfig": {
                  "properties": {
                    "azureConfig": {
                      "properties": {
                        "vaultURI": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "gcpConfig": {
                      "properties": {
                        "project": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "k8s": {
          "properties": {
            "plugins": {
              "properties": {
                "k8s": {
                  "properties": {
                    "accelerator-device-classes": {
                      "description": "Per accelerator device class (GPU, AMD_GPU, ...) overrides of the resource name and node labels, e.g. AMD_GPU.device-node-label for clusters whose AMD nodes carry their own label. A mapping, or a list of one-key mappings as in examples/values.aws.eks-automode.yaml. Set by Fleet.",
                      "type": [
                        "object",
                        "array"
                      ]
                    },
                    "accelerator-devices": {
                      "description": "Maps accelerator device names (e.g. MI355X) to the node label value their nodes carry, overriding the built-in table entry by entry. A mapping, or a list of one-key mappings. Set by Fleet.",
                      "type": [
                        "object",
                        "array"
                      ]
                    },
                    "default-labels": {
                      "type": [
                        "array",
                        "object"
                      ]
                    },
                    "gpu-device-node-label": {
                      "type": "string"
                    },
                    "gpu-partition-size-node-label": {
                      "type": "string"
                    },
                    "interruptible-node-selector-requirement": {
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "operator": {
                          "type": "string"
                        },
                        "values": {
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "interruptible-tolerations": {
                      "type": "array"
                    },
                    "non-interruptible-node-selector-requirement": {
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "operator": {
                          "type": "string"
                        },
                        "values": {
                          "type": "array"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "proxy": {
          "properties": {
            "actorConfig": {
              "properties": {
                "streamingPollerInterval": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              },
              "type": "object"
            },
            "cluster": {
              "type": "string"
            },
            "connectorLogs": {
              "properties": {
                "clientCacheSize": {
                  "type": "integer"
                },
                "clientCacheTTL": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "maxPages": {
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "imageBuilderConfig": {
              "properties": {
                "anonymousLookup": {
                  "type": "boolean"
                },
                "basicAuth": {
                  "properties": {
                    "passwordPlainText": {
                      "type": "string"
                    },
                    "passwordSecretName": {
                      "type": "string"
                    },
                    "registry": {
                      "type": "string"
                    },
                    "username": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "depotProjectId": {
                  "type": "string"
                },
                "orgDepot": {
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "namespaceTemplate": {
                      "type": "string"
                    },
                    "secret": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "repositoryOverride": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "informerResyncDuration": {
              "type": [
                "number",
                "string"
              ]
            },
            "logStreamTimeout": {
              "type": [
                "number",
                "string"
              ]
            },
            "logsServiceConfig": {
              "properties": {
                "maxConcurrentStreams": {
                  "type": "integer"
                },
                "streamingBufferSize": {
                  "type": "integer"
                },
                "streamingFlushByteSize": {
                  "type": "integer"
                },
                "streamingFlushInterval": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              },
              "type": "object"
            },
            "orgStorage": {
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            "organization": {
              "type": "string"
            },
            "persistedLogs": {
              "properties": {
                "awsCloudWatch": {
                  "properties": {
                    "aws": {
                      "properties": {
                        "account": {
                          "type": "string"
                        },
                        "region": {
                          "type": "string"
                        },
                        "retries": {
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    "groupNameTemplate": {
                      "type": "string"
                    },
                    "streamNamePrefixTemplate": {
                      "type": "string"
                    },
                    "streamNameTemplate": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "azureLogAnalytics": {
                  "properties": {
                    "logAnalyticsWorkspaceResourceIdTemplate": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "gcpLogging": {
                  "properties": {
                    "gcp": {
                      "properties": {
                        "externalAccount": {
                          "properties": {
                            "audience": {
                              "type": "string"
                            },
                            "aws": {
                              "properties": {
                                "account": {
                                  "type": "string"
                                },
                                "region": {
                                  "type": "string"
                                },
                                "retries": {
                                  "type": "integer"
                                }
                              },
                              "type": "object"
                            },
                            "enableAuthDebugTransport": {
                              "type": "boolean"
                            },
                            "scopes": {
                              "type": "array"
                            },
                            "serviceAccountImpersonationURL": {
                              "type": "string"
                            },
                            "subjectTokenType": {
                              "type": "string"
                            },
                            "type": {
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "gcpSecretManager": {
                          "properties": {
                            "replicationLocations": {
                              "type": "array"
                            },
                            "replicationPolicy": {
                              "type": "string"
                            }
                          },
                          "type": "object"
                        },
                        "project": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "resourceNames": {
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "podSessionCookiePrefixes": {
              "type": "array"
            },
            "prometheusUrl": {
              "type": "string"
            },
            "serverlessConfig": {
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "objectStoreServiceEndpoint": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "smConfig": {
              "properties": {
                "awsConfig": {
                  "properties": {
                    "account": {
                      "type": "string"
                    },
                    "region": {
                      "type": "string"
                    },
                    "retries": {
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "azureConfig": {
                  "properties": {
                    "vaultURI": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "gcpConfig": {
                  "properties": {
                    "externalAccount": {
                      "properties": {
                        "audience": {
                          "type": "string"
                        },
                        "aws": {
                          "properties": {
                            "account": {
                              "type": "string"
                            },
                            "region": {
                              "type": "string"
                            },
                            "retries": {
                              "type": "integer"
                            }
                          },
                          "type": "object"
                        },
                        "enableAuthDebugTransport": {
                          "type": "boolean"
                        },
                        "scopes": {
                          "type": "array"
                        },
                        "serviceAccountImpersonationURL": {
                          "type": "string"
                        },
                        "subjectTokenType": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "gcpSecretManager": {
                      "properties": {
                        "replicationLocations": {
                          "type": "array"
                        },
                        "replicationPolicy": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "project": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "stream": {
              "properties": {
                "modifyStreamContentType": {
                  "type": "boolean"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "global": {
      "properties": {
        "AWS_ACCOUNT_ID": {
          "description": "AWS account that owns the dataplane. Set by values.aws.yaml or Fleet.",
          "type": "string"
        },
        "AWS_REGION": {
          "description": "AWS region of the dataplane. Set by values.aws.yaml or Fleet.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "leaseworker": {
      "properties": {
        "task_logs": {
          "properties": {
            "plugins": {
              "properties": {
                "logs": {
                  "properties": {
                    "azure-log-templates": {
                      "type": "array"
                    },
                    "stackdriver-enabled": {
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "low_privilege": {
      "description": "Older name for singleNamespace, still honored. Set by Fleet.",
      "type": "boolean"
    },
    "provider": {
      "description": "Cloud the cluster runs on (aws, gcp, azure, oci, metal or custom). Set by the cloud overlay or by Fleet.",
      "type": "string"
    }
  },
  "type": "object"
}
