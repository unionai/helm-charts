{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "config": {
      "properties": {
        "core": {
          "properties": {
            "webhook": {
              "properties": {
                "embeddedSecretManagerConfig": {
                  "properties": {
                    "azureConfig": {
                      "description": "Azure Key Vault backend for embedded secrets. Set by Fleet on Azure.",
                      "properties": {
                        "vaultURI": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "gcpConfig": {
                      "description": "GCP Secret Manager backend for embedded secrets. Set by Fleet on GCP.",
                      "properties": {
                        "project": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "k8s": {
          "properties": {
            "plugins": {
              "properties": {
                "k8s": {
                  "properties": {
                    "default-labels": {
                      "description": "Labels added to every task pod. Set by values.azure.yaml or Fleet.",
                      "type": "array"
                    },
                    "gpu-device-node-label": {
                      "description": "Node label that names the GPU accelerator. Set by values.gcp.yaml, values.azure.yaml or Fleet.",
                      "type": "string"
                    },
                    "gpu-partition-size-node-label": {
                      "description": "Node label that names the GPU partition size. Set by values.gcp.yaml, values.azure.yaml or Fleet.",
                      "type": "string"
                    },
                    "interruptible-node-selector-requirement": {
                      "description": "Node selector requirement for interruptible task pods. Set by the cloud overlay or Fleet.",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "operator": {
                          "type": "string"
                        },
                        "values": {
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "interruptible-tolerations": {
                      "description": "Tolerations added to interruptible task pods. Set by values.azure.yaml or Fleet.",
                      "type": "array"
                    },
                    "non-interruptible-node-selector-requirement": {
                      "description": "Node selector requirement for non-interruptible task pods. Set by the cloud overlay or Fleet.",
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "operator": {
                          "type": "string"
                        },
                        "values": {
                          "type": "array"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "proxy": {
          "properties": {
            "persistedLogs": {
              "properties": {
                "azureLogAnalytics": {
                  "description": "Azure Log Analytics source, used when sourceType is AzureLogAnalytics. Set by values.azure.yaml or Fleet.",
                  "properties": {
                    "logAnalyticsWorkspaceResourceIdTemplate": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "gcpLogging": {
                  "description": "Cloud Logging source, used when sourceType is GCPStackdriver. Set by values.gcp.yaml or Fleet.",
                  "properties": {
                    "gcp": {
                      "properties": {
                        "project": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "smConfig": {
              "properties": {
                "awsConfig": {
                  "description": "AWS Secrets Manager backend. Set by values.aws.yaml or Fleet when type is AWS.",
                  "properties": {
                    "account": {
                      "type": "string"
                    },
                    "region": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "azureConfig": {
                  "description": "Azure Key Vault backend. Set by values.azure.yaml or Fleet when type is Azure.",
                  "properties": {
                    "vaultURI": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "gcpConfig": {
                  "description": "GCP Secret Manager backend. Set by values.gcp.yaml or Fleet when type is GCP.",
                  "properties": {
                    "project": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "global": {
      "properties": {
        "AWS_ACCOUNT_ID": {
          "description": "AWS account that owns the dataplane. Set by values.aws.yaml or Fleet.",
          "type": "string"
        },
        "AWS_REGION": {
          "description": "AWS region of the dataplane. Set by values.aws.yaml or Fleet.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "leaseworker": {
      "properties": {
        "task_logs": {
          "properties": {
            "plugins": {
              "properties": {
                "logs": {
                  "properties": {
                    "azure-log-templates": {
                      "description": "Azure log link templates. Set by Fleet on Azure.",
                      "type": "array"
                    },
                    "stackdriver-enabled": {
                      "description": "Link task logs to Cloud Logging. Set by Fleet on Azure and GCP.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "provider": {
      "description": "Cloud the cluster runs on (aws, gcp, azure, oci, metal or custom). Set by the cloud overlay or by Fleet.",
      "type": "string"
    }
  },
  "type": "object"
}
