{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "config": {
      "properties": {
        "core": {
          "properties": {
            "webhook": {
              "properties": {
                "embeddedSecretManagerConfig": {
                  "properties": {
                    "azureConfig": {
                      "properties": {
                        "vaultURI": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "gcpConfig": {
                      "properties": {
                        "project": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "k8s": {
          "properties": {
            "plugins": {
              "properties": {
                "k8s": {
                  "properties": {
                    "default-labels": {
                      "type": [
                        "array",
                        "object"
                      ]
                    },
                    "gpu-device-node-label": {
                      "type": "string"
                    },
                    "gpu-partition-size-node-label": {
                      "type": "string"
                    },
                    "interruptible-node-selector-requirement": {
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "operator": {
                          "type": "string"
                        },
                        "values": {
                          "type": "array"
                        }
                      },
                      "type": "object"
                    },
                    "interruptible-tolerations": {
                      "type": "array"
                    },
                    "non-interruptible-node-selector-requirement": {
                      "properties": {
                        "key": {
                          "type": "string"
                        },
                        "operator": {
                          "type": "string"
                        },
                        "values": {
                          "type": "array"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "proxy": {
          "properties": {
            "persistedLogs": {
              "properties": {
                "azureLogAnalytics": {
                  "properties": {
                    "logAnalyticsWorkspaceResourceIdTemplate": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "gcpLogging": {
                  "properties": {
                    "gcp": {
                      "properties": {
                        "project": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "smConfig": {
              "properties": {
                "awsConfig": {
                  "properties": {
                    "account": {
                      "type": "string"
                    },
                    "region": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "azureConfig": {
                  "properties": {
                    "vaultURI": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "gcpConfig": {
                  "properties": {
                    "project": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "global": {
      "properties": {
        "AWS_ACCOUNT_ID": {
          "description": "AWS account that owns the dataplane. Set by values.aws.yaml or Fleet.",
          "type": "string"
        },
        "AWS_REGION": {
          "description": "AWS region of the dataplane. Set by values.aws.yaml or Fleet.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "leaseworker": {
      "properties": {
        "task_logs": {
          "properties": {
            "plugins": {
              "properties": {
                "logs": {
                  "properties": {
                    "azure-log-templates": {
                      "type": "array"
                    },
                    "stackdriver-enabled": {
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "low_privilege": {
      "description": "Older name for singleNamespace, still honored. Set by Fleet.",
      "type": "boolean"
    },
    "provider": {
      "description": "Cloud the cluster runs on (aws, gcp, azure, oci, metal or custom). Set by the cloud overlay or by Fleet.",
      "type": "string"
    }
  },
  "type": "object"
}
