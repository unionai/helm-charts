          "editorMode": "code",
          "expr": "rate(flyte:admin:execution_manager:executions_created{namespace=~\"$namespace\"}[$__rate_interval])",
          "legendFormat": "created",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Execution intake rate (flyteadmin)",
      "type": "timeseries"
